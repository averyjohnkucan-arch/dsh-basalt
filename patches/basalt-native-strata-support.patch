@@ -0,0 +1,136 @@
+"""Exact import semantics: packed values, binding slices and GDN head pairing."""
+import json
+import pathlib
+import struct
+import tempfile
+import unittest
+
+import numpy as np
+import ninfer_qwen35 as N
+
+
+class ImportTests(unittest.TestCase):
+    def source(self, objects, bindings):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        path = pathlib.Path(temporary.name)/'fixture.ninfer'
+        payload, entries = bytearray(), []
+        for name, shape, form, layout, raw in objects:
+            padding = (-len(payload)) % 256
+            payload.extend(bytes(padding))
+            entries.append(dict(id=name,shape=shape,format=form,layout=layout,offset=len(payload),bytes=len(raw),kind='tensor'))
+            payload.extend(raw)
+        text = dict(model_type='qwen3_5_text',linear_num_key_heads=16,linear_num_value_heads=48,
+                    linear_key_head_dim=128,linear_value_head_dim=128)
+        directory = dict(objects=entries,bindings=bindings,components=dict(text=dict(config=text)),files=[dict(path=None,payload_bytes=len(payload))])
+        data = json.dumps(directory).encode()
+        framed = N.HEADER.pack(b'NINFER\0\3',len(data),bytes(16))+data
+        path.write_bytes(framed+bytes((-len(framed))%4096)+payload)
+        source = N.Source(path)
+        self.addCleanup(source.close)
+        return source
+
+    def test_bf16_rounding_matches_even_at_halfway(self):
+        bits = np.array([0x3f800000,0x3f808000,0x3f818000,0xbf808000,0xbf818000],dtype=np.uint32)
+        np.testing.assert_array_equal(N.bf16_bits(bits.view(np.float32)),[0x3f80,0x3f80,0x3f82,0xbf80,0xbf82])
+
+    def test_q8_repack_preserves_every_code_and_scale_and_embedding_cast(self):
+        rows, cols = 128, 256
+        codes = (np.arange(rows*cols,dtype=np.uint32)*13+97).astype(np.uint8).view(np.int8).reshape(rows,cols//32,32)
+        scales = ((np.arange(rows*cols//32)%37+1)/128).astype('<f2').reshape(rows,cols//32)
+        raw = codes.tobytes()+scales.tobytes()
+        source = self.source([('table',[rows,cols],'q8_g32_fp16','row_split_k128_v1',raw)],{'table':dict(object='table')})
+        repacked = np.frombuffer(b''.join(source.q8_chunks('table')),np.uint8).reshape(rows,cols//32,34)
+        np.testing.assert_array_equal(repacked[...,2:].view(np.int8),codes)
+        np.testing.assert_array_equal(repacked[...,:2].copy().view('<f2').reshape(scales.shape),scales)
+        expected = codes.astype(np.float64)*scales.astype(np.float64)[...,None]
+        got = np.frombuffer(b''.join(source.q8_chunks('table',True)),'<u2').reshape(expected.shape)
+        # Values are exactly represented in FP32 before the semantic BF16 output cast.
+        expected_bits = N.bf16_bits(expected.astype(np.float32))
+        np.testing.assert_array_equal(got,expected_bits)
+
+    def test_bf16_binding_slice_does_not_requantize(self):
+        values = (np.arange(512*256,dtype=np.uint32)*31).astype('<u2').reshape(512,256)
+        source = self.source([('parent',[512,256],'bf16','contiguous_le_v1',values.tobytes())],
+                             {'slice':dict(parts=[dict(object='parent',range=[128*256,384*256])])})
+        np.testing.assert_array_equal(source.matrix('slice')['bits'],values[128:384])
+        self.assertEqual(source.shape('slice'),(256,256))
+
+    def test_nvfp4_payload_and_swizzled_scales_are_exact(self):
+        rows, cols = 256, 256
+        codes = (np.arange(rows*cols//2,dtype=np.uint32)*17+5).astype(np.uint8).reshape(rows,cols//2)
+        scales = (np.arange(rows*cols//16,dtype=np.uint32)*11%127).astype(np.uint8).reshape(rows,cols//16)
+        # Independent writer of the published m128x4 scale coordinates.
+        stored = bytearray(rows*cols//16)
+        for row in range(rows):
+            for group in range(cols//16):
+                tile = (row//128)*(cols//64)+group//4
+                stored[tile*512+(row%32)*16+((row//32)%4)*4+group%4] = scales[row,group]
+        raw = codes.tobytes()+stored+struct.pack('<f',13)
+        source = self.source([('w',[rows,cols],'nvfp4','block_scale_k16_m128x4_v1',raw)],{'w':dict(object='w')})
+        matrix = source.matrix('w')
+        np.testing.assert_array_equal(matrix['codes'],codes)
+        np.testing.assert_array_equal(matrix['scales'],scales)
+        self.assertEqual(N.pack_scales(matrix['scales']),stored)
+        self.assertEqual(matrix['multiplier'],np.float32(1)/np.float32(13))
+
+    def test_gdn_reorder_preserves_query_key_and_value_pairing(self):
+        rows, cols = 10240, 256
+        codes = np.broadcast_to(np.arange(rows,dtype=np.uint32)[:,None]%256,(rows,cols//2)).astype(np.uint8).copy()
+        scales = np.broadcast_to(np.arange(rows,dtype=np.uint32)[:,None]%127,(rows,cols//16)).astype(np.uint8).copy()
+        matrix = dict(format='NVFP4_PLANES',codes=codes.copy(),scales=scales.copy(),multiplier=np.float32(1))
+        N.transform_matrix(matrix,'vrows')
+        np.testing.assert_array_equal(matrix['codes'][:4096],codes[:4096])
+        for value_head in range(48):
+            key_head = value_head%16
+            repetition = value_head//16
+            source_head = key_head*3+repetition
+            for offset in (0,17,127):
+                target_row=4096+value_head*128+offset
+                source_row=4096+source_head*128+offset
+                np.testing.assert_array_equal(matrix['codes'][target_row],codes[source_row])
+                np.testing.assert_array_equal(matrix['scales'][target_row],scales[source_row])
+        # Output columns reverse precisely that permutation, moving complete code pairs and groups.
+        c=np.arange(128*6144//2,dtype=np.uint32).astype(np.uint8).reshape(128,3072)
+        sc=np.arange(128*384,dtype=np.uint32).astype(np.uint8).reshape(128,384)
+        out=dict(format='NVFP4_PLANES',codes=c.copy(),scales=sc.copy(),multiplier=np.float32(1))
+        N.transform_matrix(out,'vcols')
+        for value_head in range(48):
+            original=(value_head%16)*3+value_head//16
+            np.testing.assert_array_equal(out['codes'][:,value_head*64:(value_head+1)*64],c[:,original*64:(original+1)*64])
+            np.testing.assert_array_equal(out['scales'][:,value_head*8:(value_head+1)*8],sc[:,original*8:(original+1)*8])
+
+    def test_partial_matrix_rows_are_refused(self):
+        source = self.source([('w',[128,256],'bf16','contiguous_le_v1',bytes(128*256*2))],
+                             {'bad':dict(parts=[dict(object='w',range=[1,257])])})
+        with self.assertRaisesRegex(ValueError,'partial matrix rows'):
+            source.shape('bad')
+
+    def test_draft_selector_materialization_and_feature_column_slices(self):
+        rows, cols = 128, 512
+        codes = (np.arange(rows*cols//2,dtype=np.uint32)*13+7).astype(np.uint8).reshape(rows,cols//2)
+        scales = (np.arange(rows*cols//16,dtype=np.uint32)%40+30).astype(np.uint8).reshape(rows,cols//16)
+        raw = codes.tobytes()+N.pack_scales(scales)+struct.pack('<f',13)
+        source = self.source([('w',[rows,cols],'nvfp4','block_scale_k16_m128x4_v1',raw)],{'w':dict(object='w')})
+        plan = N.Plan.__new__(N.Plan)
+        plan.source, plan.specs = source, []
+        plan.add('selector',('w',),'draft_bf16')
+        got = np.frombuffer(b''.join(plan.chunks(plan.specs[0])),'<u2').reshape(rows,cols)
+        magnitudes = (0,.5,1,1.5,2,3,4,6)
+        for row in (0,31,32,127):
+            for col in (0,1,15,16,255,256,511):
+                byte = int(codes[row,col//2])
+                code = (byte >> (4*(col%2))) & 15
+                scale = int(scales[row,col//16])
+                exponent, mantissa = scale>>3,scale&7
+                decoded_scale = (mantissa/8*2**-6 if exponent==0 else (1+mantissa/8)*2**(exponent-7))
+                expected = (-1 if code&8 else 1)*magnitudes[code&7]*decoded_scale/13
+                self.assertEqual(got[row,col],N.bf16_bits(np.float32(expected)))
+        plan.add('feature',('w',),'feature:1:256')
+        packed = b''.join(plan.chunks(plan.specs[-1]))
+        np.testing.assert_array_equal(np.frombuffer(packed[:rows*128],np.uint8).reshape(rows,128),codes[:,128:])
+        np.testing.assert_array_equal(N.unpack_scales(packed[rows*128:],rows,256),scales[:,16:])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tools/convert/test_strata_pack.py b/tools/convert/test_strata_pack.py
