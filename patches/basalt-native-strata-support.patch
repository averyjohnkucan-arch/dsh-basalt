diff --git a/src/models/deepseek41/engram_external.hpp b/src/models/deepseek41/engram_external.hpp
new file mode 100644
index 0000000..cf66e76
--- /dev/null
+++ b/src/models/deepseek41/engram_external.hpp
@@ -0,0 +1,46 @@
+// Optional external DeepSeek Engram: validate the original adjacent GGUF table views.
+#pragma once
+#include "basalt/artifact/gguf_reader.hpp"
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace basalt::models::deepseek41 {
+inline bool external_engram_offset(const std::string& path, uint64_t rows, uint32_t row_bytes,
+                                  int row_values, int type, const std::vector<int>& layers,
+                                  uint64_t& offset, std::string& err) {
+    try {
+        GgufFile file(path);
+        if (rows == 0 || row_bytes == 0 || row_values != 256 ||
+            (type != 20 && type != 39) || file.tensors().size() != layers.size() || layers.empty()) {
+            err = "external Engram: incompatible table geometry";
+            return false;
+        }
+        uint64_t covered = 0, bytes = 0;
+        for (size_t i = 0; i < layers.size(); ++i) {
+            const auto& t = file.tensors()[i];
+            if (t.name != "blk." + std::to_string(layers[i]) + ".engram_embd.weight" ||
+                t.type != static_cast<uint32_t>(type) || t.shape.size() != 2 ||
+                t.shape[0] != static_cast<uint64_t>(row_values) || t.shape[1] == 0 ||
+                covered > rows || t.shape[1] > rows - covered || t.offset != bytes ||
+                t.shape[1] > (std::numeric_limits<uint64_t>::max() - bytes) / row_bytes) {
+                err = "external Engram: wrong layers, type, rows or nonadjacent table offsets";
+                return false;
+            }
+            covered += t.shape[1];
+            bytes += t.shape[1] * row_bytes;
+        }
+        if (covered != rows || file.data_start() > file.file_size() ||
+            bytes != file.file_size() - file.data_start()) {
+            err = "external Engram: incomplete table or unexpected trailing payload";
+            return false;
+        }
+        offset = file.data_start();
+        return true;
+    } catch (const std::exception& e) {
+        err = std::string("external Engram: ") + e.what();
+        return false;
+    }
+}
+} // namespace basalt::models::deepseek41
