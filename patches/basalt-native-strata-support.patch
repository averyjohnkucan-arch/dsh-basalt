diff --git a/tools/convert/ninfer_qwen35.py b/tools/convert/ninfer_qwen35.py
new file mode 100644
index 0000000..0846d2a
--- /dev/null
+++ b/tools/convert/ninfer_qwen35.py
@@ -0,0 +1,379 @@
+"""Import the text component of a single-file NInfer v3 dense Qwen3.5 artifact.
+
+NVFP4 weights keep their E2M1 codes, UE4M3 scales and tensor multiplier; Q8_G32_FP16
+heads are repacked without rounding. BF16 projections stay BF16. The embedding is
+materialized as the BF16 values the source embedding Op returns. DFlash2 projections also keep their stored format; its selector is materialized as
+BF16 for the proposal-only selector. Vision and MTP are excluded. This converter does not change or copy source artifacts in place.
+"""
+from __future__ import annotations
+
+import json
+import math
+import pathlib
+import struct
+import tempfile
+from types import SimpleNamespace
+
+import numpy as np
+
+import checkpoint as C
+import checkpoint_qwen35 as Q
+import model_sections as S
+from model_file import ModelWriter, Stream, TENSOR_ALIGN
+import tokenizer
+
+HEADER = struct.Struct('<8sQ16s')
+TYPE = {'F32': 0, 'BF16': 30, 'Q8_0': 8, 'NVFP4_PLANES': 45}
+
+
+def bf16_values(bits):
+    return (np.asarray(bits, dtype=np.uint32) << 16).view(np.float32)
+
+
+def bf16_bits(values):
+    bits = np.asarray(values, dtype='<f4').view(np.uint32)
+    return ((bits + 0x7fff + ((bits >> 16) & 1)) >> 16).astype('<u2')
+
+
+def unpack_scales(raw, rows, cols):
+    if rows % 128 or cols % 64:
+        raise ValueError('NVFP4 requires 128-row and 64-column tiles')
+    # Tile axes: row block, column block, row%32, row//32%4, group%4.
+    return np.frombuffer(raw, np.uint8).reshape(rows//128, cols//64, 32, 4, 4).transpose(0, 3, 2, 1, 4).reshape(rows, cols//16).copy()
+
+
+def pack_scales(values):
+    rows, groups = values.shape
+    return values.reshape(rows//128, 4, 32, groups//4, 4).transpose(0, 3, 2, 1, 4).copy().tobytes()
+
+
+def matrix_values(matrix):
+    if matrix['format'] == 'BF16':
+        return bf16_values(matrix['bits'])
+    codes = matrix['codes']
+    unpacked = np.empty((codes.shape[0], codes.shape[1]*2),np.uint8)
+    unpacked[:,0::2],unpacked[:,1::2] = codes & 15,codes >> 4
+    return (Q.E2M1.astype(np.float32)[unpacked] *
+            np.repeat(S.fp8_e4m3_table()[matrix['scales']].astype(np.float32),16,axis=1) *
+            matrix['multiplier'])
+
+
+class Source:
+    def __init__(self, path):
+        self.path = pathlib.Path(path)
+        self.file = self.path.open('rb')
+        try:
+            magic, size, _ = HEADER.unpack(self.file.read(HEADER.size))
+            if magic != b'NINFER\0\3':
+                raise ValueError('expected NInfer v3')
+            self.directory = json.loads(self.file.read(size))
+            self.start = (HEADER.size + size + 4095) // 4096 * 4096
+            files = self.directory['files']
+            if len(files) != 1:
+                raise ValueError('this importer requires a single-file v3 artifact')
+            if self.path.stat().st_size != self.start + files[0]['payload_bytes']:
+                raise ValueError('artifact payload length mismatch')
+            self.objects = {o['id']: o for o in self.directory['objects']}
+            self.bindings = self.directory['bindings']
+            self.text = self.directory['components']['text']['config']
+            if self.text.get('model_type') != 'qwen3_5_text' or self.text.get('num_experts', 0):
+                raise ValueError('only the dense Qwen3.5 text architecture is supported')
+            geometry = tuple(self.text[k] for k in ('linear_num_key_heads', 'linear_num_value_heads', 'linear_key_head_dim', 'linear_value_head_dim'))
+            if geometry != (16, 48, 128, 128):
+                raise ValueError('unsupported GDN head order')
+        except BaseException:
+            self.file.close()
+            raise
+
+    def close(self):
+        self.file.close()
+
+    def read(self, obj, begin=0, length=None):
+        length = obj['bytes'] - begin if length is None else length
+        if begin < 0 or length < 0 or begin + length > obj['bytes']:
+            raise ValueError('object range out of bounds')
+        self.file.seek(self.start + obj['offset'] + begin)
+        data = self.file.read(length)
+        if len(data) != length:
+            raise ValueError('short object read')
+        return data
+
+    def binding(self, role):
+        binding = self.bindings[role]
+        parts = binding.get('parts') or [{'object': binding['object']}]
+        if len(parts) != 1:
+            raise ValueError(f'{role}: concatenated source bindings are unsupported')
+        part = parts[0]
+        obj = self.objects[part['object']]
+        begin, end = part.get('range', (0, math.prod(obj['shape'])))
+        if not 0 <= begin < end <= math.prod(obj['shape']):
+            raise ValueError(f'{role}: invalid logical binding range')
+        return obj, begin, end
+
+    def shape(self, role):
+        obj, begin, end = self.binding(role)
+        shape = obj['shape']
+        if len(shape) == 2:
+            if begin % shape[1] or end % shape[1]:
+                raise ValueError(f'{role}: partial matrix rows')
+            return ((end-begin)//shape[1], shape[1])
+        if begin or end != math.prod(shape):
+            raise ValueError(f'{role}: partial non-matrix binding')
+        return tuple(shape)
+
+    def raw_float(self, role):
+        obj, begin, end = self.binding(role)
+        fmt = obj['format']
+        if obj['layout'] != 'contiguous_le_v1' or fmt not in ('bf16', 'fp32'):
+            raise ValueError(f'{role}: expected contiguous BF16 or FP32')
+        size = 2 if fmt == 'bf16' else 4
+        values = np.frombuffer(self.read(obj, begin*size, (end-begin)*size), '<u2' if size == 2 else '<f4')
+        return (bf16_values(values) if size == 2 else values).reshape(self.shape(role))
+
+    def matrix(self, role):
+        obj, begin, end = self.binding(role)
+        rows, cols = self.shape(role)
+        if obj['format'] == 'bf16':
+            if obj['layout'] != 'contiguous_le_v1':
+                raise ValueError('unsupported BF16 layout')
+            bits = np.frombuffer(self.read(obj, begin*2, (end-begin)*2), '<u2').reshape(rows, cols).copy()
+            return {'format': 'BF16', 'bits': bits}
+        if obj['format'] != 'nvfp4' or obj['layout'] != 'block_scale_k16_m128x4_v1':
+            raise ValueError(f'{role}: matrix format {obj["format"]} unsupported')
+        n, k = obj['shape']
+        code_bytes = n*k//2
+        scale_offset = (code_bytes+255)//256*256
+        scales = unpack_scales(self.read(obj, scale_offset, n*k//16), n, k)
+        codes = np.frombuffer(self.read(obj, begin//2, (end-begin)//2), np.uint8).reshape(rows, cols//2).copy()
+        divisor = struct.unpack('<f', self.read(obj, scale_offset+n*k//16, 4))[0]
+        if not math.isfinite(divisor) or divisor <= 0:
+            raise ValueError('invalid NVFP4 divisor')
+        return {'format': 'NVFP4_PLANES', 'codes': codes, 'scales': scales[begin//k:end//k], 'multiplier': np.float32(1)/np.float32(divisor)}
+
+    def q8_chunks(self, role, embedding=False):
+        obj, begin, end = self.binding(role)
+        n, k = obj['shape']
+        if begin or end != n*k or obj['format'] != 'q8_g32_fp16' or obj['layout'] != 'row_split_k128_v1' or k % 128:
+            raise ValueError(f'{role}: expected whole Q8-G32 row-split matrix')
+        scale_offset = (n*k + 255)//256*256
+        for row in range(0, n, 1024):
+            count = min(1024, n-row)
+            codes = np.frombuffer(self.read(obj, row*k, count*k), np.int8).reshape(count, k//32, 32)
+            scales = np.frombuffer(self.read(obj, scale_offset+row*k//16, count*k//16), '<f2').reshape(count, k//32)
+            if embedding:
+                yield bf16_bits(codes.astype(np.float32)*scales.astype(np.float32)[..., None]).tobytes()
+            else:
+                blocks = np.empty((count, k//32, 34), np.uint8)
+                blocks[..., :2] = scales.copy().view(np.uint8).reshape(count, k//32, 2)
+                blocks[..., 2:] = codes.view(np.uint8)
+                yield blocks.tobytes()
+
+
+def transform_matrix(matrix, how):
+    if how == 'id':
+        return matrix
+    cols = matrix['bits'].shape[1] if matrix['format'] == 'BF16' else matrix['codes'].shape[1]*2
+    rows = matrix['bits'].shape[0] if matrix['format'] == 'BF16' else matrix['codes'].shape[0]
+    if how in ('vrows', 'zrows'):
+        indices = S.gdn_index(rows, S.GDN_QK_ROWS if how == 'vrows' else 0)
+        for key in ('bits', 'codes', 'scales'):
+            if key in matrix:
+                matrix[key] = matrix[key][indices].copy()
+    elif how == 'vcols':
+        indices = S.gdn_index(cols, 0)
+        if matrix['format'] == 'BF16':
+            matrix['bits'] = matrix['bits'][:, indices].copy()
+        else:
+            # The permutation moves 128-wide heads: packed pairs and groups stay whole.
+            matrix['codes'] = matrix['codes'][:, indices[::2]//2].copy()
+            matrix['scales'] = matrix['scales'][:, indices[::16]//16].copy()
+    else:
+        raise ValueError(f'unsupported matrix transform {how}')
+    return matrix
+
+
+class Plan:
+    def __init__(self, source):
+        self.source = source
+        self.specs = []
+        self.add('token_embd.weight', ('text/token_embedding',), 'embedding')
+        self.add('output.weight', ('text/output_head',), 'q8')
+        self.add('output_norm.weight', ('text/final_norm',), 'norm')
+        for layer, kind in enumerate(source.text['layer_types']):
+            p, g = f'text/layers/{layer}/', f'blk.{layer}.'
+            for role, name in [('input_norm', 'attn_norm.weight'), ('post_attention_norm', 'post_attention_norm.weight')]:
+                self.add(g+name, (p+role,), 'norm')
+            for role in ('gate', 'up', 'down'):
+                self.add(g+f'ffn_{role}.weight', (p+'mlp/'+role,), 'id')
+            if kind == 'linear_attention':
+                rules = [('attn_qkv.weight', ('query', 'key', 'value'), 'vrows'),
+                         ('attn_gate.weight', ('z',), 'zrows'), ('ssm_out.weight', ('output',), 'vcols'),
+                         ('ssm_alpha.weight', ('a_projection',), 'heads_bf16'),
+                         ('ssm_beta.weight', ('b_projection',), 'heads_bf16'),
+                         ('ssm_a', ('a_log',), 'negexp'), ('ssm_dt.bias', ('dt_bias',), 'heads'),
+                         ('ssm_conv1d.weight', ('convolution',), 'conv'), ('ssm_norm.weight', ('norm',), 'float')]
+                for name, roles, how in rules:
+                    self.add(g+name, tuple(p+'gdn/'+role for role in roles), how)
+            elif kind == 'full_attention':
+                for name, roles, how in [('attn_q.weight', ('query', 'gate'), 'qgate'),
+                    ('attn_k.weight', ('key',), 'id'), ('attn_v.weight', ('value',), 'id'),
+                    ('attn_output.weight', ('output',), 'id'), ('attn_q_norm.weight', ('query_norm',), 'norm'),
+                    ('attn_k_norm.weight', ('key_norm',), 'norm')]:
+                    self.add(g+name, tuple(p+'attention/'+role for role in roles), how)
+            else:
+                raise ValueError(f'unknown layer kind {kind}')
+        if 'dflash2'in source.directory['components']:
+            self.add_drafter()
+
+    def add_drafter(self):
+        config=self.source.directory['components']['dflash2']['config']
+        if config.get('architectures')!=['DFlash2DraftModel'] or set(config['layer_types'])!={'sliding_attention'}:
+            raise ValueError('unsupported DFlash2 architecture')
+        dc=config['dflash_config'];hidden=self.source.text['hidden_size']
+        for j,_ in enumerate(dc['target_layer_ids']):
+            self.add(f'dflash.fc.{j}.weight',('dflash2/feature_projection',),f'feature:{j}:{hidden}')
+        for name,role in [('hidden_norm.weight','context_norm'),('norm.weight','final_norm')]:
+            self.add('dflash.'+name,('dflash2/'+role,),'float')
+        for name,role in [('hidden.weight','hidden_projection'),('pred','predecessor_codebook'),('succ','successor_codebook')]:
+            self.add('dflash.selector.'+name,('dflash2/candidate_selector/'+role,),'draft_bf16')
+        rules=[('attn_norm.weight','input_norm','float'),('post_attention_norm.weight','post_attention_norm','float'),
+               ('attn_q.weight','attention/query','id'),('attn_k.weight','attention/key','id'),
+               ('attn_v.weight','attention/value','id'),('attn_output.weight','attention/output','id'),
+               ('attn_q_norm.weight','attention/query_norm','float'),('attn_k_norm.weight','attention/key_norm','float'),
+               ('ffn_gate.weight','mlp/gate','id'),('ffn_up.weight','mlp/up','id'),('ffn_down.weight','mlp/down','id'),
+               ('attn_conv.base','attention_conv/base_kernel','float'),('attn_conv.weight','attention_conv/kernel_projection','id'),
+               ('ffn_conv.base','mlp_conv/base_kernel','float'),('ffn_conv.weight','mlp_conv/kernel_projection','id')]
+        for layer in range(config['num_hidden_layers']):
+            for name,role,how in rules:
+                self.add(f'dflash.blk.{layer}.'+name,(f'dflash2/layers/{layer}/'+role,),how)
+
+    def drafter_kv(self):
+        if 'dflash2'not in self.source.directory['components']:return {}
+        c=self.source.directory['components']['dflash2']['config'];dc=c['dflash_config'];a='qwen35.dflash.'
+        return {a+'block_count':c['num_hidden_layers'],a+'block_size':8,a+'mask_token_id':dc['mask_token_id'],
+                a+'target_layers':dc['target_layer_ids'],a+'conv_kernel':dc['conv_kernel_size'],a+'conv_group':dc['conv_group_size'],
+                a+'selector_rank':dc['selector_rank'],a+'selector_top_k':dc['selector_top_k'],a+'sliding_window':c['sliding_window'],
+                a+'attention.head_count':c['num_attention_heads'],a+'attention.head_count_kv':c['num_key_value_heads'],
+                a+'attention.key_length':c['head_dim'],a+'feed_forward_length':c['intermediate_size'],
+                a+'rope.freq_base':float(c['rope_parameters']['rope_theta']),a+'attention.layer_norm_rms_epsilon':float(c['rms_norm_eps'])}
+
+    def add(self, name, roles, how):
+        shape = self.source.shape(roles[0])
+        if len(roles)>1:
+            shape = (sum(self.source.shape(role)[0] for role in roles), shape[1])
+        obj = self.source.binding(roles[0])[0]
+        form = {'embedding': 'BF16', 'q8': 'Q8_0', 'heads_bf16': 'BF16', 'draft_bf16':'BF16'}.get(how)
+        if form is None:
+            form = 'F32' if how in ('norm', 'float', 'heads', 'negexp', 'conv') else {'bf16':'BF16','nvfp4':'NVFP4_PLANES'}[obj['format']]
+        if how.startswith('feature:'):
+            shape=(shape[0],int(how.split(':')[2]))
+        if how == 'conv':
+            shape = tuple(reversed(shape))
+        elements = math.prod(shape)
+        size = {'BF16':elements*2,'F32':elements*4,'Q8_0':elements//32*34,'NVFP4_PLANES':elements//16*9}[form]
+        self.specs.append(dict(name=name, roles=roles, how=how, shape=list(reversed(shape)), form=form, size=size))
+
+    def chunks(self, spec):
+        roles, how = spec['roles'], spec['how']
+        if how in ('embedding', 'q8'):
+            yield from self.source.q8_chunks(roles[0], how == 'embedding')
+            return
+        if how in ('norm', 'float', 'heads', 'heads_bf16', 'negexp', 'conv'):
+            values = self.source.raw_float(roles[0])
+            if how == 'norm': values = values + np.float32(1)
+            elif how in ('heads', 'heads_bf16', 'negexp'): values = values[S.gdn_block_source()]
+            if how == 'negexp': values = -np.exp(values)
+            elif how == 'conv': values = values.T[S.gdn_index(values.shape[1], S.GDN_QK_ROWS)]
+            yield bf16_bits(values).tobytes() if how == 'heads_bf16' else values.astype('<f4').tobytes()
+            return
+        matrices = [self.source.matrix(role) for role in roles]
+        matrix = matrices[0]
+        if len(matrices)>1:
+            if any(m['format'] != matrix['format'] for m in matrices):
+                raise ValueError('mixed source formats in one matrix')
+            for key in ('bits', 'codes', 'scales'):
+                if key in matrix: matrix[key] = np.concatenate([m[key] for m in matrices])
+            if matrix['format'] == 'NVFP4_PLANES' and any(m['multiplier'] != matrix['multiplier'] for m in matrices):
+                raise ValueError('different tensor scales in one matrix')
+        if how=='draft_bf16':
+            yield bf16_bits(matrix_values(matrix)).tobytes()
+            return
+        if how.startswith('feature:'):
+            _,index,width=how.split(':');start=int(index)*int(width);end=start+int(width)
+            if matrix['format']=='BF16':matrix['bits']=matrix['bits'][:,start:end].copy()
+            else:
+                matrix['codes']=matrix['codes'][:,start//2:end//2].copy()
+                matrix['scales']=matrix['scales'][:,start//16:end//16].copy()
+        elif how == 'qgate':
+            # Source [all query heads, all gate heads]; target [query, gate] per head.
+            n, k = self.source.shape(roles[0]); d = self.source.text['head_dim']
+            for key in ('bits', 'codes', 'scales'):
+                if key in matrix:
+                    width = matrix[key].shape[1]
+                    matrix[key] = matrix[key].reshape(2,n//d,d,width).transpose(1,0,2,3).reshape(2*n,width).copy()
+        else:
+            transform_matrix(matrix, how)
+        if matrix['format'] == 'BF16':
+            yield matrix['bits'].astype('<u2').tobytes()
+        else:
+            yield matrix['codes'].tobytes()
+            yield pack_scales(matrix['scales'])
+
+    def multiplier(self, spec):
+        obj, _, _ = self.source.binding(spec['roles'][0]);n,k = obj['shape']
+        at = ((n*k//2+255)//256*256)+n*k//16
+        divisor = struct.unpack('<f',self.source.read(obj,at,4))[0]
+        if divisor<=0 or not math.isfinite(divisor):raise ValueError('invalid NVFP4 divisor')
+        return struct.pack('<f',np.float32(1)/np.float32(divisor))
+
+
+def convert(args):
+    out = pathlib.Path(args.out)
+    if out.resolve() == pathlib.Path(args.ninfer).resolve():
+        raise ValueError('output must differ from the source artifact')
+    if out.exists() and not args.force:
+        raise ValueError(f'{out} exists')
+    source = Source(args.ninfer)
+    partial = out.with_suffix(out.suffix+'.partial')
+    writer = None
+    try:
+        plan = Plan(source)
+        with tempfile.TemporaryDirectory(dir=out.parent) as tmp:
+            directory = pathlib.Path(tmp)
+            for name in ('tokenizer.json','tokenizer_config.json','generation_config.json','chat_template.jinja'):
+                obj = source.objects.get('frontend/'+name)
+                if obj: (directory/name).write_bytes(source.read(obj))
+            interval = source.text['layer_types'].index('full_attention')+1
+            tc = dict(source.text, attn_output_gate=True, full_attention_interval=interval, mtp_num_hidden_layers=0)
+            added = {t['content']:t['id'] for t in json.loads((directory/'tokenizer.json').read_text()).get('added_tokens',[])}
+            config = dict(image_token_id=added['<|image_pad|>'], video_token_id=added['<|video_pad|>'], vision_start_token_id=added['<|vision_start|>'])
+            ck = SimpleNamespace(dir=directory,text=tc,config=config)
+            kv = Q.model_kv(ck,args.name or source.directory.get('metadata',{}).get('name','Qwen3.5'))
+            kv.update(plan.drafter_kv())
+            tokenizer.extract_metadata(kv,directory)
+            writer = ModelWriter(str(partial))
+            for path in sorted((directory/'tokenizer').iterdir()):
+                if path.is_file():writer.add_file('tokenizer/'+path.name,str(path))
+            specs, parts = [], []
+            for spec in plan.specs:
+                specs.append(spec)
+                parts.append(Stream(spec['size'],plan.chunks(spec)))
+                if spec['form'] == 'NVFP4_PLANES':
+                    specs.append(dict(name=spec['name'].removesuffix('.weight')+'.scale',form='F32',shape=[1],size=4))
+                    parts.append(plan.multiplier(spec))
+            offsets = writer.add_parts('gguf',parts,TENSOR_ALIGN)
+            tensors = {s['name']:dict(type=s['form'],type_id=TYPE[s['form']],shape=s['shape'],bytes=s['size'],offset=off) for s,off in zip(specs,offsets)}
+            meta = dict(format='basalt',version=2,arch='qwen35',name=kv['general.name'],gguf_kv=kv,tensors=tensors,
+                converter=dict(tool='tools/convert/convert.py --ninfer'),sources=[dict(path=source.path.name,size=source.path.stat().st_size)],
+                mtp=dict(layers=0),conversions=dict(source='NInfer v3 text',weights='NVFP4 and BF16 preserved, Q8 head losslessly repacked',embedding='Q8 values rounded once to semantic BF16',excluded_components=['vision','mtp'],draft_selector='NVFP4 represented values rounded to BF16 for Basalt proposal selection; target weights unchanged'))
+            meta['required_engine_features']=['qwen35-bf16-projections']
+            if plan.drafter_kv():meta['required_engine_features'].append('qwen35-nvfp4-dflash2')
+            if plan.drafter_kv():meta['dflash']=dict(source='NInfer v3 DFlash2',block_size=8,selector='BF16 materialized from represented NVFP4 values; proposal only')
+            writer.add_bytes('meta',json.dumps(meta,separators=(',',':'),ensure_ascii=False).encode())
+            writer.close();writer=None
+            partial.replace(out)
+            print(f'Imported {len(tensors)} tensors to {out} ({out.stat().st_size/2**30:.3f} GiB)',flush=True)
+    finally:
+        source.close()
+        if writer is not None:writer.f.close()
+        partial.unlink(missing_ok=True)
