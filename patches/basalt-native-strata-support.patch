diff --git a/tools/convert/strata_pack.py b/tools/convert/strata_pack.py
new file mode 100644
index 0000000..0b330be
--- /dev/null
+++ b/tools/convert/strata_pack.py
@@ -0,0 +1,129 @@
+"""Read a native NVFP4/Q8 Strata pack without requantizing its experts or drafter."""
+from __future__ import annotations
+
+from dataclasses import replace
+import hashlib
+import math
+from pathlib import Path
+import re
+
+from gguf_reader import GGUFFile
+import model_sections as S
+
+
+def chunks(path):
+    with Path(path).open("rb") as source:
+        for block in iter(lambda: source.read(16 << 20), b""):
+            yield block
+
+
+def overlay(model, ple, embedding):
+    """Replace the embedding view and attach the separately stored, scaled FP8 PLE table."""
+    first = model.files[0]
+    if first.metadata.get("general.architecture") != "qwen4exp":
+        raise S.ConvertError("--strata-pack requires qwen4exp")
+    if "prism.hadamard.version" in first.metadata:
+        raise S.ConvertError("Hadamard-rotated experts are not supported")
+    for path, name in ((ple, "per_layer_token_embd.weight"), (embedding, "token_embd.weight")):
+        path = Path(path)
+        g = GGUFFile(path)
+        if len(g.tensors) != 1 or g.tensors[0].name != name:
+            raise S.ConvertError(f"{path}: expected only {name}")
+        tensor = g.tensors[0]
+        if name.startswith("per_layer_"):
+            scale = g.metadata.get("strata.ple.scale")
+            if (tensor.type_id != 24 or tensor.shape[0] != 160 or
+                    g.metadata.get("strata.ple.format") != "f8_e4m3" or
+                    not isinstance(scale, (float, int)) or not math.isfinite(scale) or scale <= 0):
+                raise S.ConvertError("expected Strata's scaled E4M3 PLE table")
+            tensor = replace(tensor, type_id=44, type_name="F8_E4M3")
+            first.metadata["basalt.ple.scale"] = scale
+        elif tensor.type_id != 30 or tensor.shape != model.where[name][1].shape:
+            raise S.ConvertError("the BF16 embedding shape does not match the dense GGUF")
+        if tensor.expected_bytes() is None or g.data_start + tensor.offset + tensor.expected_bytes() != path.stat().st_size:
+            raise S.ConvertError(f"{path}: incomplete or oversized tensor payload")
+        model.paths.append(path)
+        model.files.append(g)
+        model.sizes.append(path.stat().st_size)
+        model.where[name] = (g, tensor, path)
+
+
+class Experts:
+    def __init__(self, root, model):
+        root = Path(root)
+        self.path = root / "experts.bin"
+        table = (root / "native_experts.txt").read_text()
+        if not table.startswith("# strata native experts v3:"):
+            raise S.ConvertError("expected Strata native expert layout v3")
+        kv = model.files[0].metadata
+        h, ff, layers = (int(kv["qwen4exp." + name]) for name in
+                         ("embedding_length", "expert_feed_forward_length", "block_count"))
+        self.n_expert = int(kv["qwen4exp.expert_count"])
+        self.layout = []
+        at = 0
+        for line in table.splitlines():
+            if not line.strip() or line.startswith("#"):
+                continue
+            fields = line.split()
+            if len(fields) != 5:
+                raise S.ConvertError("malformed native expert layout")
+            layer, gu, down, offset, size = map(int, fields)
+            if gu not in (8, 40) or down not in (8, 40):
+                raise S.ConvertError("only NVFP4 and Q8_0 expert projections are supported")
+            def row(ty, width):
+                block, nb = (64, 36) if ty == 40 else (32, 34)
+                if width % block:
+                    raise S.ConvertError("expert width is not whole blocks")
+                return width // block * nb
+            expected = 2 * ff * row(gu, h) + h * row(down, ff) + (16 if 40 in (gu, down) else 0)
+            if layer != len(self.layout) or offset != at or size != expected:
+                raise S.ConvertError(f"layer {layer}: inconsistent expert geometry or offset")
+            self.layout.append((layer, gu, down, offset, size))
+            at += size * self.n_expert
+        if len(self.layout) != layers or at != self.path.stat().st_size:
+            raise S.ConvertError("expert file is incomplete or does not match the dense model")
+        self.total = at
+
+    def layout_text(self):
+        return S.nvfp4_layout_text(self.n_expert, self.total, self.layout)
+
+    def chunks(self):
+        # Canonical unit scales for Q8 projections let every prefill path reuse the scale tail.
+        with self.path.open("rb") as source:
+            for _, gu, down, offset, size in self.layout:
+                if 40 in (gu, down):
+                    import struct
+                    for expert in range(self.n_expert):
+                        source.seek(offset + (expert + 1) * size - 16)
+                        scales = struct.unpack("<4f", source.read(16))
+                        if (not all(math.isfinite(s) and s > 0 for s in scales[:3]) or
+                                (gu == 8 and scales[:2] != (1., 1.)) or (down == 8 and scales[2] != 1.)):
+                            raise S.ConvertError("invalid NVFP4 scales or non-unit Q8 scales")
+        yield from chunks(self.path)
+
+
+class Mtp:
+    tuned = None
+
+    def __init__(self, root):
+        self.root = Path(root)
+        self.index = (self.root / "dense.txt").read_bytes()
+        size = (self.root / "dense.bin").stat().st_size
+        for line in self.index.decode().splitlines():
+            name, kind, rows, cols, offset, length = line.split()
+            if kind not in ("q8_0", "f32", "bf16") or min(int(rows), int(cols), int(length)) <= 0 or int(offset) < 0 or int(offset) + int(length) > size:
+                raise S.ConvertError("invalid native MTP dense index")
+        if (self.root / "experts.bin").stat().st_size != 512 * (1280 * 640 + 2560 * 160 + 1280 * 40 * 2 + 2560 * 10 * 2):
+            raise S.ConvertError("native MTP experts have the wrong size")
+
+    def source_sha256(self):
+        return hashlib.sha256(self.index).hexdigest()
+
+    def dense_index(self):
+        return self.index
+
+    def dense_chunks(self):
+        yield from chunks(self.root / "dense.bin")
+
+    def expert_chunks(self):
+        yield from chunks(self.root / "experts.bin")
