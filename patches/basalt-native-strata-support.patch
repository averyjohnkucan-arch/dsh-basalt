+import hashlib
+from pathlib import Path
+import struct
+import tempfile
+from types import SimpleNamespace
+import unittest
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import strata_pack as P
+import model_sections as S
+
+
+class StrataPackTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        self.addCleanup(self.temp.cleanup)
+        self.model = SimpleNamespace(files=[SimpleNamespace(metadata={
+            "qwen4exp.embedding_length": 2560, "qwen4exp.expert_feed_forward_length": 640,
+            "qwen4exp.block_count": 4, "qwen4exp.expert_count": 1})])
+        self.rows = []
+        at = 0
+        with (self.root / "experts.bin").open("wb") as out:
+            for layer, (gu, down) in enumerate(((40, 40), (40, 8), (8, 40), (8, 8))):
+                gr = 2560 // (64 if gu == 40 else 32) * (36 if gu == 40 else 34)
+                dr = 640 // (64 if down == 40 else 32) * (36 if down == 40 else 34)
+                tail = 16 if 40 in (gu, down) else 0
+                size = 1280 * gr + 2560 * dr + tail
+                self.rows.append([layer, gu, down, at, size])
+                if tail:
+                    out.seek(at + size - 16)
+                    out.write(struct.pack("<4f", .001 if gu == 40 else 1., .002 if gu == 40 else 1.,
+                                          .003 if down == 40 else 1., 0.))
+                at += size
+            out.truncate(at)
+        self.write_layout()
+
+    def write_layout(self):
+        (self.root / "native_experts.txt").write_text("# strata native experts v3: test\n" +
+            "".join(" ".join(map(str, row)) + "\n" for row in self.rows))
+
+    def test_four_formats_stream_byte_for_byte(self):
+        experts = P.Experts(self.root, self.model)
+        self.assertEqual(experts.total, (self.root / "experts.bin").stat().st_size)
+        digest = hashlib.sha256()
+        for block in experts.chunks():
+            digest.update(block)
+        with (self.root / "experts.bin").open("rb") as source:
+            self.assertEqual(digest.digest(), hashlib.file_digest(source, "sha256").digest())
+        self.assertTrue(experts.layout_text().startswith(b"# experts v6:"))
+
+    def test_missing_or_truncated_layer(self):
+        for field, value in ((0, 8), (1, 14), (3, 1), (4, 2)):
+            with self.subTest(field=field):
+                old = self.rows[0][field]
+                self.rows[0][field] = value
+                self.write_layout()
+                with self.assertRaises(S.ConvertError):
+                    P.Experts(self.root, self.model)
+                self.rows[0][field] = old
+        self.write_layout()
+        with (self.root / "experts.bin").open("r+b") as stream:
+            stream.truncate(128)
+        with self.assertRaises(S.ConvertError):
+            P.Experts(self.root, self.model)
+
+    def test_nonunit_q8_and_nonfinite_nvfp4_scale_rejected(self):
+        for layer, scales in ((1, (.001, .002, 2., 0.)), (2, (1., 2., .003, 0.)),
+                              (0, (float("nan"), .002, .003, 0.))):
+            with self.subTest(layer=layer):
+                row = self.rows[layer]
+                with (self.root / "experts.bin").open("r+b") as out:
+                    out.seek(row[3] + row[4] - 16)
+                    original = out.read(16)
+                    out.seek(-16, 1)
+                    out.write(struct.pack("<4f", *scales))
+                with self.assertRaises(S.ConvertError):
+                    next(P.Experts(self.root, self.model).chunks())
+                with (self.root / "experts.bin").open("r+b") as out:
+                    out.seek(row[3] + row[4] - 16)
+                    out.write(original)
+
+
+if __name__ == "__main__":
+    unittest.main()
