+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <cuda_runtime.h>
+
+namespace basalt::prefill::bf16 {
+// Row-major W[N,K] and X[T,K], column-major Y[N,T], FP32 accumulation.
+void product(void* handle, const uint16_t* x, const uint16_t* w, float* y,
+             int64_t T, int64_t N, int64_t K, int64_t ldy, float beta = 0.0f);
+class Context {
+public:
+    Context() = default;
+    ~Context();
+    Context(const Context&) = delete;
+    Context& operator=(const Context&) = delete;
+    bool init(std::string& err);
+    void run(const uint16_t* x, const uint16_t* w, float* y,
+             int64_t T, int64_t N, int64_t K, cudaStream_t stream);
+private:
+    void* handle_ = nullptr;
+    void* workspace_ = nullptr;
+};
+}
