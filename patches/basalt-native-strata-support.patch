+
+namespace {
+uint32_t mix(uint32_t v) {
+    v ^= v >> 16; v *= 0x7feb352d; v ^= v >> 15; v *= 0x846ca68b; return v ^ (v >> 16);
+}
+uint16_t bits(float x) { uint32_t u; std::memcpy(&u,&x,4); return uint16_t((u+0x7fff+((u>>16)&1))>>16); }
+float value(uint16_t b) { uint32_t u=uint32_t(b)<<16; float x; std::memcpy(&x,&u,4); return x; }
+void check(cudaError_t e) { if(e!=cudaSuccess) throw std::runtime_error(cudaGetErrorString(e)); }
+}
+int main() {
+    int devices=0;
+    if(cudaGetDeviceCount(&devices)!=cudaSuccess || devices==0) return 77;
+    try {
+        basalt::prefill::bf16::Context context;
+        std::string error;
+        if(!context.init(error)) throw std::runtime_error(error);
+        double max_abs=0, max_scaled=0;
+        for(const auto shape : {std::pair<int,int>{128,256}, {12288,5120}, {5120,6144}}) {
+            const int N=shape.first,K=shape.second;
+            std::vector<uint16_t> w(size_t(N)*K), x(size_t(4096)*K);
+            for(size_t i=0;i<w.size();++i) w[i]=bits((int(mix(uint32_t(i)+17)%511)-255)/512.0f);
+            for(size_t i=0;i<x.size();++i) x[i]=bits((int(mix(uint32_t(i)+97)%511)-255)/128.0f);
+            uint16_t *dw=nullptr,*dx=nullptr;float*dy=nullptr;
+            check(cudaMalloc(&dw,w.size()*2));check(cudaMalloc(&dx,x.size()*2));check(cudaMalloc(&dy,size_t(4096)*N*4));
+            check(cudaMemcpy(dw,w.data(),w.size()*2,cudaMemcpyHostToDevice));check(cudaMemcpy(dx,x.data(),x.size()*2,cudaMemcpyHostToDevice));
+            for(int T : {1,4,7,16,17,33,4096}) {
+                context.run(dx,dw,dy,T,N,K,nullptr);check(cudaDeviceSynchronize());
+                for(int t : {0,T/2,T-1}) for(int n : {0,1,N/3,N/2,N-1}) {
+                    double reference=0,mass=0;
+                    for(int k=0;k<K;++k){double p=double(value(w[size_t(n)*K+k]))*value(x[size_t(t)*K+k]);reference+=p;mass+=std::abs(p);}
+                    float got;check(cudaMemcpy(&got,dy+size_t(t)*N+n,4,cudaMemcpyDeviceToHost));
+                    const double abs=std::abs(double(got)-reference),scaled=abs/std::max(1.0,mass);
+                    max_abs=std::max(max_abs,abs);max_scaled=std::max(max_scaled,scaled);
+                    if(!std::isfinite(got)||scaled>2e-6) throw std::runtime_error("BF16 product differs from FP64 oracle");
+                }
+            }
+            cudaFree(dw);cudaFree(dx);cudaFree(dy);
+        }
+        std::printf("OK BF16 product real attention shapes T=1,4,7,16,17,33,4096 max_abs=%.9g max_error_over_sum_abs=%.9g\n",max_abs,max_scaled);
+        return 0;
+    } catch(const std::exception& e) { std::fprintf(stdout,"FAIL %s\n",e.what());return 1; }
+}
