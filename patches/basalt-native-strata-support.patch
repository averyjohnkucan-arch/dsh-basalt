+++ b/tools/convert/test_legacy_deepseek.py
@@ -0,0 +1,55 @@
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import legacy_deepseek as L
+import model_sections as S
+from gguf_writer import GGUFWriter, TYPE_IDS
+
+
+class LegacyDeepSeekTest(unittest.TestCase):
+    def test_tables_and_integer_metadata_keep_their_meaning(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            TYPE_IDS.update(I32=26, I64=27)
+            writer = GGUFWriter()
+            writer.add("general.architecture", "deepseek41")
+            for name, value in (("engram.layer_ids", [1, 14]), ("engram_max_ngram_size", 2),
+                                ("engram_n_heads", 2), ("engram_pad_token_id", 2)):
+                writer.add("deepseek41." + name, value)
+            for name, values, code, ty in (("token_map", [0, 1, 2, -1], "i", "I32"),
+                                           ("primes", [5, 7, 11, 13], "q", "I64"),
+                                           ("offsets", [0, 5, 0, 11], "q", "I64"),
+                                           ("multipliers", [3, 5, 7, 11], "q", "I64")):
+                writer.add_raw("engram_" + name + ".weight", [len(values)], ty,
+                               struct.pack("<" + str(len(values)) + code, *values))
+            for layer in (1, 14):
+                writer.add_raw(f"blk.{layer}.engram_q.weight", [2, 1], "BF16", struct.pack("<2H", 0x3f80, 0xc000))
+                writer.add_raw(f"blk.{layer}.engram_k.weight", [2, 1], "BF16", struct.pack("<2H", 0x4000, 0x4040))
+                writer.add_raw(f"blk.{layer}.engram_wkv.weight", [32, 1], "Q8_0", bytes(34))
+            dense = writer.write(root / "model.gguf")
+            writer = GGUFWriter()
+            for layer, rows in ((1, 12), (14, 24)):
+                writer.add_raw(f"blk.{layer}.engram_embd.weight", [256, rows], "IQ4_NL", bytes([layer]) * (rows * 144))
+            engram = writer.write(root / "engram.gguf")
+            model = S.SourceModel([dense])
+            L.overlay(model, engram)
+            self.addCleanup(model._legacy_gate_temp.cleanup)
+            kv = model.files[0].metadata
+            self.assertEqual(kv["deepseek41.ple.head_offsets"], [0, 5, 12, 23])
+            self.assertEqual(kv["deepseek41.engram.token_map"], [0, 1, 2, -1])
+            self.assertEqual(kv["deepseek41.ple.layer_multipliers"], [3, 5, 7, 11])
+            self.assertFalse(any(name.startswith("engram_") for name in model.where))
+            tensor = model.where["per_layer_token_embd.weight"][1]
+            self.assertEqual(tensor.shape, [256, 36])
+            self.assertEqual(model.bytes(tensor.name).tobytes(), bytes([1]) * (12 * 144) + bytes([14]) * (24 * 144))
+            self.assertEqual(model.bytes("blk.1.engram_gate.weight").tobytes(), struct.pack("<2f", 2., -6.))
+            self.assertIn("blk.14.engram_kv.weight", model.where)
+
