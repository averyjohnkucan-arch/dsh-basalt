+            ap.error("--strata-pack needs --gguf, --ple-gguf and --embd-gguf; it cannot combine with another source mode")
+    elif a.ple_gguf or a.embd_gguf or a.strata_mtp:
+        ap.error("--ple-gguf, --embd-gguf and --strata-mtp need --strata-pack")
     if a.into or a.roll_back or a.undo_dir:
         if not a.into or not a.undo_dir or bool(a.dspark) == a.roll_back or a.out or a.gguf or a.sections_from or a.checkpoint or a.requant_dense_q6k:
