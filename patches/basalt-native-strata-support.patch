+#include "basalt/prefill/bf16_gemm.hpp"
+#include <cublas_v2.h>
+#include <limits>
+#include <stdexcept>
+
+namespace basalt::prefill::bf16 {
+namespace {
+constexpr size_t kWorkspace = 32u << 20;
+void check(cublasStatus_t status, const char* call) {
+    if (status != CUBLAS_STATUS_SUCCESS)
+        throw std::runtime_error(std::string("BF16 product: ") + call + ": cuBLAS " + std::to_string(int(status)));
+}
+}
+void product(void* handle, const uint16_t* x, const uint16_t* w, float* y,
+             int64_t T, int64_t N, int64_t K, int64_t ldy, float beta) {
+    if (T <= 0 || N <= 0 || K <= 0 || ldy < N ||
+        T > std::numeric_limits<int>::max() || N > std::numeric_limits<int>::max() ||
+        K > std::numeric_limits<int>::max() || ldy > std::numeric_limits<int>::max())
+        throw std::invalid_argument("BF16 product: invalid matrix geometry");
+    const float alpha = 1.0f;
+    check(cublasGemmEx(static_cast<cublasHandle_t>(handle), CUBLAS_OP_T, CUBLAS_OP_N,
+        int(N), int(T), int(K), &alpha, w, CUDA_R_16BF, int(K), x, CUDA_R_16BF, int(K),
+        &beta, y, CUDA_R_32F, int(ldy), CUBLAS_COMPUTE_32F, CUBLAS_GEMM_DEFAULT), "cublasGemmEx");
+}
+Context::~Context() {
+    if (handle_) cublasDestroy(static_cast<cublasHandle_t>(handle_));
+    if (workspace_) cudaFree(workspace_);
+}
+bool Context::init(std::string& err) {
+    cublasHandle_t handle = nullptr;
+    const auto status = cublasCreate(&handle);
+    if (status != CUBLAS_STATUS_SUCCESS) {
+        err = "BF16 product: cublasCreate: " + std::to_string(int(status));
+        return false;
+    }
+    handle_ = handle;
+    const auto allocated = cudaMalloc(&workspace_, kWorkspace);
+    if (allocated != cudaSuccess) {
+        err = std::string("BF16 product: workspace: ") + cudaGetErrorString(allocated);
+        return false;
+    }
+    return true;
+}
+void Context::run(const uint16_t* x, const uint16_t* w, float* y,
+                   int64_t T, int64_t N, int64_t K, cudaStream_t stream) {
+    const auto h = static_cast<cublasHandle_t>(handle_);
+    check(cublasSetStream(h, stream), "cublasSetStream");
+    check(cublasSetWorkspace(h, workspace_, kWorkspace), "cublasSetWorkspace");
+    product(handle_, x, w, y, T, N, K, N);
+}
+}
