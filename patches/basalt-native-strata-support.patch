diff --git a/tests/ngram/ple_fp8_test.cpp b/tests/ngram/ple_fp8_test.cpp
new file mode 100644
index 0000000..9be6cd6
--- /dev/null
+++ b/tests/ngram/ple_fp8_test.cpp
@@ -0,0 +1,62 @@
+#include "../core/gguf_fixture.hpp"
+#include "basalt/models/qwen4exp/kernels/ngram.hpp"
+
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <limits>
+
+int main() {
+    namespace fs = std::filesystem;
+    namespace k = basalt::kernels;
+    const fs::path dir = fs::temp_directory_path() /
+        ("basalt-ple-fp8-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    fs::create_directories(dir);
+    int failures = 0;
+    const auto path = dir / "table.gguf";
+    auto write = [&](bool scale, uint32_t value) {
+        std::vector<fixture::Kv> kv;
+        if (scale) kv.push_back(fixture::u32("basalt.ple.scale", value));
+        fixture::write(path, kv, {{"per_layer_token_embd.weight", {160, 32}, 44, 1}});
+    };
+    write(true, 2);
+    for (auto mode : {k::PleIo::Mmap, k::PleIo::Direct}) {
+        k::PleTable table;
+        k::PleIoOptions options;
+        options.mode = mode;
+        std::string error;
+        if (!table.open(path.string(), error, options)) {
+            std::printf("open: %s\n", error.c_str()); ++failures; continue;
+        }
+        auto check = [&](uint32_t row, const float* values) {
+            for (int i = 0; i < 160; ++i) {
+                const uint8_t code = fixture::pattern(1, (uint64_t) row * 160 + i);
+                const int bits = code & 127, e = bits >> 3, m = bits & 7;
+                const double sign = code & 128 ? -1. : 1.;
+                const double magnitude = e ? (8. + m) * std::pow(2., e - 10) : m / 512.;
+                const float want = (float) (sign * magnitude * 2.);
+                if (bits == 127) failures += !std::isnan(values[i]);
+                else failures += std::memcmp(&want, values + i, sizeof want) != 0;
+            }
+        };
+        for (uint32_t row = 0; row < 32; ++row) {
+            float values[160]; table.read_row(row, values); check(row, values);
+        }
+        uint32_t rows[16];
+        for (int i = 0; i < 16; ++i) rows[i] = (uint32_t) (31 - i);
+        float values[16 * 160];
+        if (!table.issue(rows) || !table.collect(values, error)) ++failures;
+        else for (int i = 0; i < 16; ++i) check(rows[i], values + i * 160);
+    }
+    for (bool scale : {false, true}) {
+        write(scale, 0);
+        k::PleTable table;
+        std::string error;
+        failures += table.open(path.string(), error);
+    }
+    fs::remove_all(dir);
+    std::printf("FP8 PLE: all codes, mmap/direct, scalar/batch, invalid scale: %d failures\n", failures);
+    return failures ? 1 : 0;
+}
