diff --git a/tools/convert/legacy_deepseek.py b/tools/convert/legacy_deepseek.py
new file mode 100644
index 0000000..ea69e63
--- /dev/null
+++ b/tools/convert/legacy_deepseek.py
@@ -0,0 +1,83 @@
+"""Normalize IST-DAS Engram metadata and join its adjacent table views without changing any weight bytes."""
+from dataclasses import replace
+from pathlib import Path
+import re
+import tempfile
+import numpy as np
+
+from gguf_reader import GGUFFile
+from gguf_writer import GGUFWriter
+import model_sections as S
+
+
+def overlay(model, path):
+    kv = model.files[0].metadata
+    prefix = "deepseek41."
+    if kv.get("general.architecture") != "deepseek41":
+        raise S.ConvertError("--engram-gguf requires deepseek41")
+    path = Path(path)
+    table = GGUFFile(path)
+    layers, rows, offset = [], [], 0
+    for tensor in table.tensors:
+        match = re.fullmatch(r"blk\.(\d+)\.engram_embd\.weight", tensor.name)
+        if not match or tensor.type_id != 20 or len(tensor.shape) != 2 or tensor.shape[0] != 256 or tensor.offset != offset:
+            raise S.ConvertError("expected adjacent IQ4_NL Engram tables with 256 values per row")
+        layers.append(int(match[1]))
+        rows.append(tensor.shape[1])
+        offset += tensor.expected_bytes()
+    if not rows or table.data_start + offset != path.stat().st_size or kv.get(prefix + "engram.layer_ids") != layers:
+        raise S.ConvertError("incomplete Engram table or mismatched layer ids")
+    ints = {}
+    for name, kind in (("token_map", "<i4"), ("primes", "<i8"), ("offsets", "<i8"), ("multipliers", "<i8")):
+        tensor = "engram_" + name + ".weight"
+        ints[name] = np.frombuffer(model.bytes(tensor), dtype=kind).tolist()
+        del model.where[tensor]
+    ng = int(kv[prefix + "engram_max_ngram_size"])
+    heads = int(kv[prefix + "engram_n_heads"])
+    columns = (ng - 1) * heads
+    if (len(ints["primes"]) != len(rows) * columns or len(ints["offsets"]) != len(rows) * columns or
+            len(ints["multipliers"]) != len(rows) * ng):
+        raise S.ConvertError("Engram hash parameter shapes do not match the tables")
+    before = 0
+    for layer, count in enumerate(rows):
+        at = layer * columns
+        primes, offsets = ints["primes"][at:at + columns], ints["offsets"][at:at + columns]
+        expected = np.cumsum([0] + primes[:-1]).tolist()
+        if sum(primes) != count or offsets != expected:
+            raise S.ConvertError("Engram primes/offsets do not cover the layer's rows")
+        ints["offsets"][at:at + columns] = [value + before for value in offsets]
+        before += count
+    for name, value in {
+        "ple.layers": layers, "ple.ngram_size": ng, "ple.heads_per_ngram": heads,
+        "ple.layer_multipliers": ints["multipliers"], "ple.head_vocab_sizes": ints["primes"],
+        "ple.head_offsets": ints["offsets"], "embedding_length_per_layer_input": 256,
+        "engram.token_map": ints["token_map"], "engram.pad_token_id": kv[prefix + "engram_pad_token_id"],
+    }.items():
+        kv[prefix + name] = value
+    tensor = replace(table.tensors[0], name="per_layer_token_embd.weight", shape=[256, sum(rows)], offset=0)
+    model.paths.append(path)
+    model.files.append(table)
+    model.sizes.append(path.stat().st_size)
+    model.where[tensor.name] = (table, tensor, path)
+    gates = GGUFWriter()
+    for layer in layers:
+        prefix = f"blk.{layer}.engram_"
+        names = [prefix + role + ".weight" for role in ("q", "k")]
+        ts = [model.where[name][1] for name in names]
+        if any(t.type_id != 30 for t in ts) or ts[0].shape != ts[1].shape:
+            raise S.ConvertError("expected matching BF16 Engram q/k weights")
+        values = [(np.frombuffer(model.bytes(name), dtype="<u2").astype(np.uint32) << 16).view(np.float32) for name in names]
+        gates.add_raw(prefix + "gate.weight", ts[0].shape, "F32", (values[0] * values[1]).astype("<f4").tobytes())
+        for name in names:
+            del model.where[name]
+        old = prefix + "wkv.weight"
+        source, t, p = model.where.pop(old)
+        model.where[prefix + "kv.weight"] = (source, replace(t, name=prefix + "kv.weight"), p)
+    model._legacy_gate_temp = tempfile.TemporaryDirectory(prefix="basalt-engram-gates-")
+    generated = gates.write(Path(model._legacy_gate_temp.name) / "engram-gates.gguf")
+    g = GGUFFile(generated)
+    model.paths.append(generated)
+    model.files.append(g)
+    model.sizes.append(generated.stat().st_size)
+    for tensor in g.tensors:
+        model.where[tensor.name] = (g, tensor, generated)
